# API key de Mapas Bogotá (opcional).
# Obligatoria SOLO para la consulta por dirección (geocodificacion).
# Sin esta variable, resolve_lot_by_address falla rapido con CREDENCIAL_FALTANTE;
# las consultas por CHIP y por coordenadas siguen funcionando.
MAPAS_BOGOTA_APIKEY=

# Feature 2 (RAG normativo del POT, Decreto 555/2021): servidor Ollama remoto + ChromaDB.

# Bind moderno de Ollama (HTTP API): se usa para verificar disponibilidad.
# Apunta a un servidor Ollama remoto en la LAN (no a localhost).
OLLAMA_HOST=http://192.168.40.91:11434

# Endpoint base que usa ChromaDB (OllamaEmbeddingFunction) para embeddings.
# Usa el endpoint legado /api/embeddings de Ollama (research D4/D5).
# Mismo servidor remoto que OLLAMA_HOST.
OLLAMA_BASE_URL=http://192.168.40.91:11434

# Modelo de embeddings (multilingüe, 1024 dims). Debe existir en el servidor
# remoto y ser byte-idéntico (mismo digest de `ollama pull bge-m3`) para que el
# índice ChromaDB sea compatible sin rebuild. Si cambias OLLAMA_EMBEDDING_MODEL,
# el índice se reconstruye automáticamente al re-indexar (el modelo se persiste
# en la metadata de la colección); si usas un cliente externo, borra .data/
# manualmente.
OLLAMA_EMBEDDING_MODEL=bge-m3

# Modelo de chat para generar respuestas (disponible en el servidor remoto).
OLLAMA_CHAT_MODEL=qwen3.5:9b

# Fuente oficial del articulado del POT (sisjur). Se usa en la ingesta del corpus.
CORPUS_URL=https://www.alcaldiabogota.gov.co/sisjur/normas/Norma1.jsp?i=119582

# Directorio de persistencia del índice vectorial (dato derivado, gitignored).
VECTOR_DB_PATH=.data/chroma

# Dimensiones del modelo de embeddings (bge-m3 = 1024). Se usa SOLO para validar
# la dimensión de los vectores recuperados y en los mocks/tests.
EMBEDDING_DIM=1024

# Feature 5 (interfaz web de prefactibilidad): FastAPI + Jinja2 + HTMX.
# La capa web reutiliza ServidorLotes sin protocolo MCP; se ejecuta con:
#   web-mcp-bogota-factibilidad   (o: python -m app.web.main)

# Host y puerto del servidor web (default: local).
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Ruta del repositorio SQLite de proyectos de prefactibilidad (dato derivado,
# gitignored como el indice vectorial).
PROYECTOS_DB_PATH=.data/proyectos.db
