# API key de Mapas Bogotá (opcional).
# Solo se usa para la geocodificacion por direccion via Mapas Bogota.
# Si no esta configurada, la geocodificacion hace fallback automatico al
# World GeocodeServer de ArcGIS (geocode.arcgis.com) sin clave; no hay
# fallo rapido por CREDENCIAL_FALTANTE en resolve_lot_by_address/get_upl.
# Las consultas por CHIP y por coordenadas no la usan.
MAPAS_BOGOTA_APIKEY=

# Feature 2 (RAG normativo del POT, Decreto 555/2021): servidor Ollama remoto + ChromaDB.

# Bind moderno de Ollama (HTTP API): se usa para verificar disponibilidad.
# Apunta a un servidor Ollama remoto en la LAN (no a localhost).
OLLAMA_HOST=http://192.168.40.91:11434

# Endpoint base que usa ChromaDB (OllamaEmbeddingFunction) para embeddings.
# Usa el endpoint legado /api/embeddings de Ollama (research D4/D5).
# Mismo servidor remoto que OLLAMA_HOST.
OLLAMA_BASE_URL=http://192.168.40.91:11434

# Modelo de embeddings (multilingüe, 1024 dims). Debe existir en el servidor
# remoto y ser byte-idéntico (mismo digest de `ollama pull bge-m3`) para que el
# índice ChromaDB sea compatible sin rebuild. Si cambias OLLAMA_EMBEDDING_MODEL,
# el índice se reconstruye automáticamente al re-indexar (el modelo se persiste
# en la metadata de la colección); si usas un cliente externo, borra .data/
# manualmente.
OLLAMA_EMBEDDING_MODEL=bge-m3

# Modelo de chat para generar respuestas (disponible en el servidor remoto).
OLLAMA_CHAT_MODEL=qwen3.5:9b

# Fuente oficial del articulado del POT (sisjur). Se usa en la ingesta del corpus.
CORPUS_URL=https://www.alcaldiabogota.gov.co/sisjur/normas/Norma1.jsp?i=119582

# Directorio de persistencia del índice vectorial (dato derivado, gitignored).
VECTOR_DB_PATH=.data/chroma

# Dimensiones del modelo de embeddings (bge-m3 = 1024). Se usa SOLO para validar
# la dimensión de los vectores recuperados y en los mocks/tests.
EMBEDDING_DIM=1024

# Feature 5 (interfaz web de prefactibilidad): FastAPI + Jinja2 + HTMX.
# La capa web reutiliza ServidorLotes sin protocolo MCP; se ejecuta con:
#   web-mcp-bogota-factibilidad   (o: python -m app.web.main)

# Host y puerto del servidor web (default: local).
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Ruta del repositorio SQLite de proyectos de prefactibilidad (dato derivado,
# gitignored como el indice vectorial).
PROYECTOS_DB_PATH=.data/proyectos.db

# Fase 5 (caché por lote): TTL en segundos de la caché en memoria (LRU con
# máximo 128 entradas) para los resultados de resolución de lote por CHIP
# (Mapas Bogotá + capa ArcGIS Lote). Solo se cachean resultados exitosos.
# Default 3600; 0 = desactivada (cada consulta va a la fuente).
CACHE_TTL_SEGUNDOS=3600

# Feature 12 (exposicion remota del servidor MCP, Fase 1): transporte Streamable
# HTTP opcional conviviendo con stdio (default). El modo HTTP sirve el endpoint
# /mcp con validacion de Origin y cierre de providers encadenado; las 7 tools
# responden EXACTAMENTE el mismo payload que por stdio.
#   python -m app.main --transport http [--host HOST] [--port PUERTO]
# Requiere 'uvicorn' (extra web: uv sync --extra web).

# Transporte MCP: stdio (default, comportamiento historico del Dockerfile CMD)
# o http (Streamable HTTP en /mcp). Otro valor aborta el arranque con mensaje
# claro (fail-fast).
MCP_TRANSPORT=stdio

# Bind SOLO modo http. Default 127.0.0.1 (loopback): no abrir a la red salvo
# decision explicita del operador (0.0.0.0 detras de TLS/tunel).
MCP_HOST=127.0.0.1

# Puerto modo http (1-65535).
MCP_PORT=8000

# Allowlist CSV de origenes 'Origin' de navegador (anti DNS-rebinding, spec MCP
# 2025-06-18). VACIO = se rechaza todo Origin presente (403) y se permiten
# clientes sin Origin (curl, mcp-remote, Inspector, Claude Code). Para servir
# desde un tunel/dominio, lista los origenes exactos, p. ej.:
#   MCP_ALLOWED_ORIGINS=https://demo-abc123.trycloudflare.com
# De cada origen se deriva tambien el Host permitido del tunel/dominio.
MCP_ALLOWED_ORIGINS=
